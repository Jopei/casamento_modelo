# Copie para backend/.env no servidor e preencha. Nao versione o .env.
# Gere a chave com: docker compose -f docker-compose.prod.yml run --rm app php artisan key:generate --show

APP_NAME="Casamento Joaquim"
APP_ENV=production
APP_KEY=
# Precisa ser o endereco publico real: e a partir dele que o Laravel monta
# as URLs das imagens (Storage::url). Errado aqui = fotos quebradas.
APP_URL=https://seudominio.com.br
APP_DEBUG=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=casamento
DB_USERNAME=casamento_user
# Troque as duas por senhas longas e aleatorias:
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Site e API na mesma origem em producao, entao nao ha requisicao entre
# origens. Mantenha restrito; use "*" apenas se hospedar o site separado.
CORS_ALLOWED_ORIGINS=https://seudominio.com.br
FRONTEND_URL=https://seudominio.com.br

# Senha do primeiro admin, usada só pelo seeder na carga inicial.
# Troque depois pelo painel e remova esta linha.
ADMIN_EMAIL=
ADMIN_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"
